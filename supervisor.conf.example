[program:habibi-stay-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/habibi-stay/artisan queue:work redis --sleep=3 --tries=3 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=4
redirect_stderr=true
stdout_logfile=/var/www/habibi-stay/storage/logs/worker.log
stopwaitsecs=3600
startretries=3
priority=100
